<%- include('partials/head', { title: title }) %>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { activeNav: activeNav }) %>
    <div class="main">
      <%- include('partials/topbar', { title: title }) %>
      <div class="content">

        <div class="card mb-16">
          <div class="field-row" style="grid-template-columns: repeat(5, 1fr);">
            <div class="field">
              <label for="fEnv">Environment</label>
              <select id="fEnv"><option value="">All</option><option value="PAPER">PAPER</option><option value="LIVE">LIVE</option></select>
            </div>
            <div class="field">
              <label for="fSource">Source</label>
              <select id="fSource"><option value="">All</option><option value="MANUAL">MANUAL</option><option value="BOT">BOT</option></select>
            </div>
            <div class="field">
              <label for="fSymbol">Symbol</label>
              <input type="text" id="fSymbol" placeholder="e.g. BTCUSD" />
            </div>
            <div class="field">
              <label for="fStatus">Status</label>
              <select id="fStatus">
                <option value="">All</option>
                <option value="PENDING">PENDING</option>
                <option value="SUBMITTED">SUBMITTED</option>
                <option value="FILLED">FILLED</option>
                <option value="PARTIALLY_FILLED">PARTIALLY_FILLED</option>
                <option value="REJECTED">REJECTED</option>
                <option value="CANCELLED">CANCELLED</option>
                <option value="ERROR">ERROR</option>
              </select>
            </div>
            <div class="field">
              <label>&nbsp;</label>
              <button class="btn btn-secondary btn-block" id="applyFilters">Apply Filters</button>
            </div>
          </div>
        </div>

        <div class="table-wrap">
          <table>
            <thead><tr>
              <th>Order ID</th><th>Env</th><th>Source</th><th>Symbol</th><th>Side</th><th>Type</th>
              <th>Qty</th><th>Req. Price</th><th>Exec. Price</th><th>Status</th><th>Fees</th><th>Time</th>
            </tr></thead>
            <tbody id="ordersBody"><tr><td colspan="12"><div class="empty-state">Loading…</div></td></tr></tbody>
          </table>
        </div>

      </div>
    </div>
  </div>
  <%- include('partials/scripts') %>
  <script src="/js/orders.js"></script>
</body>
</html>
