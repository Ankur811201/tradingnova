<%- include('partials/head', { title: title }) %>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { activeNav: activeNav }) %>
    <div class="main">
      <%- include('partials/topbar', { title: title }) %>
      <div class="content">

        <div class="card mb-16">
          <div class="field-row" style="grid-template-columns: repeat(4, 1fr);">
            <div class="field">
              <label for="fEnv">Environment</label>
              <select id="fEnv"><option value="">All</option><option value="PAPER">PAPER</option><option value="LIVE">LIVE</option></select>
            </div>
            <div class="field">
              <label for="fSource">Source</label>
              <select id="fSource"><option value="">All</option><option value="MANUAL">MANUAL</option><option value="BOT">BOT</option></select>
            </div>
            <div class="field">
              <label for="fSymbol">Symbol</label>
              <input type="text" id="fSymbol" placeholder="e.g. BTCUSD" />
            </div>
            <div class="field">
              <label>&nbsp;</label>
              <button class="btn btn-secondary btn-block" id="applyFilters">Apply Filters</button>
            </div>
          </div>
        </div>

        <div class="table-wrap">
          <table>
            <thead><tr>
              <th>Trade ID</th><th>Env</th><th>Source</th><th>Symbol</th><th>Side</th>
              <th>Entry</th><th>Exit</th><th>Qty</th><th>Fees</th><th>Realized P&amp;L</th><th>Closed</th>
            </tr></thead>
            <tbody id="tradesBody"><tr><td colspan="11"><div class="empty-state">Loading…</div></td></tr></tbody>
          </table>
        </div>

      </div>
    </div>
  </div>
  <%- include('partials/scripts') %>
  <script src="/js/trades.js"></script>
</body>
</html>
