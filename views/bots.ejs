<%- include('partials/head', { title: title }) %>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { activeNav: activeNav }) %>
    <div class="main">
      <%- include('partials/topbar', { title: title }) %>
      <div class="content">

        <!-- ============================================================
             SECTION 1 — Page header
             Redesigned: title/subtitle on the left, primary "+ Create New
             Bot" action on the right. The button opens the SAME create
             form/flow that already existed on this page — it now lives in
             a modal instead of being always visible, but every field id,
             the form's submit handler, and the underlying POST
             /api/bot-instances call are unchanged (see bots.js).
        ============================================================= -->
        <div class="bots-page-header">
          <div>
            <h2 class="bots-page-title">Bots</h2>
            <p class="bots-page-subtitle">Manage your automated trading bots.</p>
          </div>
          <button type="button" class="btn btn-primary btn-lg" id="openCreateModalBtn">+ Create New Bot</button>
        </div>

        <!-- ============================================================
             CREATE BOT MODAL — MODEL_002-only.
             Fields: instName, instModel (fixed, readonly = MODEL_002),
             instSymbol, instEnv, instLeverage, instCapital, trend radios,
             instResistance1-3, instSupport1-3, timeframe radios,
             createForm, createBtn, createAlert. MODEL_001 does not appear
             anywhere in this form. No new backend calls are introduced.
        ============================================================= -->
       <div class="modal-overlay hidden" id="createBotModal">
  <div class="modal modal-lg">

    <div class="modal-header">
      <h3>Create New Bot</h3>
      <button type="button" class="modal-close" id="closeCreateModalBtn">&times;</button>
    </div>

    <div id="createAlert" class="alert alert-danger hidden"></div>

    <form id="createForm">

      <!-- ===================== -->
      <!-- BASIC INFORMATION -->
      <!-- ===================== -->

      <div class="field">
        <label for="instName">Bot Name</label>
        <input
          id="instName"
          type="text"
          placeholder="My BTC Scalper"
          required>
      </div>

      <div class="field-row">

        <div class="field">
          <label for="instModel">Bot Model</label>
          <input id="instModel" type="text" value="MODEL_002" readonly class="readonly-field">
          <small>MODEL_002 — Custom Pattern</small>
        </div>

        <div class="field">
          <label for="instSymbol">Trading Pair</label>
          <select id="instSymbol" required></select>
        </div>

      </div>

      <div class="field-row">

        <div class="field">
          <label for="instEnv">Trading Mode</label>

          <select id="instEnv">

            <option value="PAPER">
              📝 Paper Trading
            </option>

            <option value="LIVE">
              💰 Live Trading
            </option>

          </select>
        </div>

        <div class="field">
          <label for="instLeverage">Leverage</label>
          <input id="instLeverage" type="number" min="1" max="200" step="1" value="1" required>
          <small>1x to 200x.</small>
        </div>

      </div>

      <div class="field">

        <label for="instCapital">

          Maximum Capital (USD)

        </label>

        <input
          id="instCapital"
          type="number"
          min="1"
          step="0.01"
          placeholder="100"
          required>

        <small>
          The maximum capital this bot is allowed to use. This is separate from leverage — the
          model's own risk sizing determines the actual position, capped so notional exposure
          never exceeds Maximum Capital &times; Leverage.
        </small>

      </div>

      <!-- ===================== -->
      <!-- MODEL_002 STRATEGY INPUTS -->
      <!-- Shown only when Bot Model = MODEL_002. Trend and every support/  -->
      <!-- resistance level are supplied directly by the user — MODEL_002  -->
      <!-- never calculates them (no Daily BOS, no EMA, no 1H confirmation). -->
      <!-- ===================== -->

      <div id="model002Section">

        <div class="card mt-16">
          <div class="card-header"><h4>Market Trend</h4></div>
          <div class="card-body">
            <div class="field-row" style="grid-template-columns:repeat(2,1fr);">
              <label class="radio-option">
                <input type="radio" name="instTrend" id="trendBullish" value="BULLISH" checked>
                <span>📈 Bullish</span>
              </label>
              <label class="radio-option">
                <input type="radio" name="instTrend" id="trendBearish" value="BEARISH">
                <span>📉 Bearish</span>
              </label>
            </div>
            <small>You supply the market trend — the bot does not calculate it.</small>
          </div>
        </div>

        <div class="card mt-16">
          <div class="card-header"><h4>Resistance Levels</h4></div>
          <div class="card-body">
            <div class="field-row" style="grid-template-columns:repeat(3,1fr);">
              <div class="field">
                <label for="instResistance1">Resistance Level 1 *</label>
                <input id="instResistance1" type="number" step="any" min="0" placeholder="65000" required>
              </div>
              <div class="field">
                <label for="instResistance2">Resistance Level 2 *</label>
                <input id="instResistance2" type="number" step="any" min="0" placeholder="64990" required>
              </div>
              <div class="field">
                <label for="instResistance3">Resistance Level 3 *</label>
                <input id="instResistance3" type="number" step="any" min="0" placeholder="64700" required>
              </div>
            </div>
            <small>All 3 required.</small>
          </div>
        </div>

        <div class="card mt-16">
          <div class="card-header"><h4>Support Levels</h4></div>
          <div class="card-body">
            <div class="field-row" style="grid-template-columns:repeat(3,1fr);">
              <div class="field">
                <label for="instSupport1">Support Level 1 *</label>
                <input id="instSupport1" type="number" step="any" min="0" placeholder="64400" required>
              </div>
              <div class="field">
                <label for="instSupport2">Support Level 2 *</label>
                <input id="instSupport2" type="number" step="any" min="0" placeholder="64350" required>
              </div>
              <div class="field">
                <label for="instSupport3">Support Level 3 *</label>
                <input id="instSupport3" type="number" step="any" min="0" placeholder="64300" required>
              </div>
            </div>
            <small>All 3 required.</small>
          </div>
        </div>

        <div class="card mt-16">
          <div class="card-header"><h4>Execution Timeframe</h4></div>
          <div class="card-body">
            <div class="field-row" style="grid-template-columns:repeat(2,1fr);">
              <label class="radio-option">
                <input type="radio" name="instTimeframe" id="tf1m" value="1m" checked>
                <span>1 Minute</span>
              </label>
              <label class="radio-option">
                <input type="radio" name="instTimeframe" id="tf3m" value="3m">
                <span>3 Minutes</span>
              </label>
            </div>
          </div>
        </div>

      </div>

      <button
        type="submit"
        class="btn btn-primary btn-block mt-24"
        id="createBtn">

        🚀 Create Bot

      </button>

    </form>

  </div>
</div>

        <!-- ============================================================
             SECTION 2 — Active Bots
             Each running/paused/stopped instance now renders as one large
             premium card (bots.js#renderInstances) instead of a small
             info row. Everything inside a card is rendered from data
             already returned by /api/bot-instances, /api/positions and
             /api/logs/strategy-events — no new endpoints.
        ============================================================= -->
        <div class="section-title"><h2>Active Bots</h2></div>
        <div id="instancesList" class="bot-cards"><div class="empty-state">Loading…</div></div>

      </div>
    </div>
  </div>
  <%- include('partials/scripts') %>
  <script src="/js/bots.js"></script>
</body>
</html>