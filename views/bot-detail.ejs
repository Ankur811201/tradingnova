        <!-- INDICATORS TAB -->
        <div class="tab-panel" data-tab="indicators" data-active="false">
          <% if (bot.modelId === 'MODEL_002') { %>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
            <div class="glass-tight rounded-xl p-3 text-center">
