            <table class="w-full text-left text-xs">
              <thead class="text-gray-500 border-b border-white/5 uppercase font-mono">
                <tr>
                  <th class="pb-2 pr-3">Side</th>
                  <th class="pb-2 pr-3">Entry</th>
                  <th class="pb-2 pr-3">Exit</th>
                  <th class="pb-2 pr-3">PnL</th>
                  <th class="pb-2">Reason</th>
                </tr>
              </thead>
              <!-- NOVA TRADE -- PART 9: rows are real Trade documents
                   (models/Trade.js: side is LONG/SHORT, realizedPnl/reason
                   are the actual field names -- there is no `pnl` or
