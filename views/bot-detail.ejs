  <!-- INLINE DATA BOOTSTRAP -->
 <!-- Place this script in views/bot-detail.ejs BEFORE loading bot-detail-ws.js -->
<script>
  window.BOT_RECORDINGS_ENABLED = true;
  window.BOT_CONFIG = {
  instanceId: "<%= bot.instanceId || bot._id %>",
  modelId: "<%= bot.modelId || 'MODEL_UNKNOWN' %>",
  pair: "<%= bot.symbol || bot.tradingPair || 'BTCUSD' %>",
  // Same immutable baseline the candles API and Model002 hydration already
  // use (candle.timestamp >= createdAt) — exposed here so the chart's live
  // candle path can apply the identical rule, never a separate one.
  createdAtMs: <%- (bot.createdAt) ? bot.createdAt.getTime() : 'null' %>,
  // PART 11 — PHASE N/X: the backend-authoritative lifecycle status at
  // page-load time, used to drive the Control Center button state machine
  // (see applyButtonStateForStatus below) so Start/Pause/Stop/Restart never
  // start out in a state that contradicts what the backend actually thinks
  // is happening (e.g. Start enabled while already RUNNING).
  status: "<%= bot.status || 'STOPPED' %>",
  // NOVA TRADE -- PART 10: the bot's own candle timeframe, reused (not
  // re-derived) so execution markers anchor to the same candles the chart
  // already loaded from /api/bot-instances/:instanceId/candles.
  // PART 13.1 -- PHASE D: the Part 12.2 "'5m' matches real runtime state"
  // justification that used to live here is no longer true and has been
  // removed. BotManager.createInstance now writes an explicit timeframe
  // into `parameters` for every NEW bot (a deliberate creation-time
  // default, chosen once), and the active model onStart / validateAndMergeParameters
  // now THROW rather than default when an existing instance's timeframe is
  // missing -- so a bot that reaches this page with no persisted
  // parameters.timeframe genuinely has no working timeframe, and cannot
  // actually be running on 5m candles. Emitting '' here (rendered as "--"
  // by the client, see bot-detail-ws.js/bot-detail-chart.js) is the honest
  // value; a stored-but-invalid timeframe still fails loudly elsewhere.
  timeframe: "<%= (bot.parameters && bot.parameters.timeframe) || '' %>",
  // ONE-TIME OPPOSITE-MARKET SWITCH: the timeframe this bot is ACTUALLY
  // analysing. Equals `timeframe` for any bot that never switched; '1m'
  // afterwards. Chart candles, execution markers and the next-candle
  // countdown all follow this value so none of them can go stale.
  activeTimeframe: "<%= (bot.parameters && bot.parameters.timeframeSwitched === true && bot.parameters.activeTimeframe) || (bot.parameters && bot.parameters.timeframe) || '' %>",
  timeframeSwitched: <%- (bot.parameters && bot.parameters.timeframeSwitched === true) ? 'true' : 'false' %>,
  // Legacy level/target configuration is exposed only to legacy models.
  // MODEL_002 has no Top/Bottom/Target overlay data in its chart config;
  // its chart source is exclusively the user-configured Support/Resistance
  // below. Keeping the legacy keys empty for MODEL_002 prevents accidental
  // consumption by future chart code while preserving compatibility for
  // legacy models/tests that still use those configuration overlays.
  levels: <%- bot.modelId === 'MODEL_002' ? 'null' : JSON.stringify({
    top: (bot.levels && bot.levels.top != null) ? bot.levels.top : ((bot.parameters && bot.parameters.topLevel != null) ? bot.parameters.topLevel : null),
    bottom: (bot.levels && bot.levels.bottom != null) ? bot.levels.bottom : ((bot.parameters && bot.parameters.bottomLevel != null) ? bot.parameters.bottomLevel : null)
  }) %>,
  targets: <%- bot.modelId === 'MODEL_002' ? '[]' : JSON.stringify((bot.targets || []).map(function(t){ return t.price; })) %>,
  // MODEL_002 — user-configured Support/Resistance (exactly 3 each, never
  // auto-detected). Empty arrays for any other model. Consumed by
  // syncConfiguredLevelOverlays() in bot-detail-chart.js to draw S1-S3/
  // R1-R3 reference lines using the SAME values shown in Bot Configuration
  // above — no separate/derived source.
  support: <%- JSON.stringify((bot.parameters && Array.isArray(bot.parameters.support)) ? bot.parameters.support : []) %>,
  resistance: <%- JSON.stringify((bot.parameters && Array.isArray(bot.parameters.resistance)) ? bot.parameters.resistance : []) %>,
  // PERSISTENT LEVEL-TOUCH STATE — this bot's own latch, straight from the
  // authoritative BotInstance.parameters (written by BotManager when
  // MODEL_002 emitted LEVEL_TOUCHED). Per-instance by construction. Used
  // only as a one-way floor on page load, so a decision stored before this
  // feature existed still shows "Support: TOUCHED" correctly — the browser
  // never detects a touch itself.
  levelTouch: <%- JSON.stringify({
    supportTouched: !!(bot.parameters && bot.parameters.supportTouched === true),
    supportTouchedAt: (bot.parameters && typeof bot.parameters.supportTouchedAt === 'number') ? bot.parameters.supportTouchedAt : null,
    supportTouchedLevel: (bot.parameters && typeof bot.parameters.supportTouchedLevel === 'number') ? bot.parameters.supportTouchedLevel : null,
    supportTouchedIndex: (bot.parameters && typeof bot.parameters.supportTouchedIndex === 'number') ? bot.parameters.supportTouchedIndex : null,
    resistanceTouched: !!(bot.parameters && bot.parameters.resistanceTouched === true),
    resistanceTouchedAt: (bot.parameters && typeof bot.parameters.resistanceTouchedAt === 'number') ? bot.parameters.resistanceTouchedAt : null,
    resistanceTouchedLevel: (bot.parameters && typeof bot.parameters.resistanceTouchedLevel === 'number') ? bot.parameters.resistanceTouchedLevel : null,
    resistanceTouchedIndex: (bot.parameters && typeof bot.parameters.resistanceTouchedIndex === 'number') ? bot.parameters.resistanceTouchedIndex : null
  }) %>
};
  // NOVA TRADE -- PART 8: the real legacy decision (StrategyEvent,
  // eventType 'DECISION') loaded server-side in controllers/botController.js.
  // bot-detail-ws.js renders this immediately on page load so the Decision
  // Engine panel shows the bot's last real decision without waiting for the
  // next closed candle. Null when the bot has never produced a decision yet.
  window.BOT_INITIAL_DECISION = <%- JSON.stringify(typeof initialDecision !== 'undefined' && initialDecision ? initialDecision.payload : null) %>;

  // NOVA TRADE -- PART 9: authoritative execution-state bootstrap.
  // BOT_INITIAL_POSITION is a real Position document (or null); BOT_PERFORMANCE
  // is the server-computed performance summary (utils/performance.js). Both
  // are consumed by bot-detail-ws.js to keep the live bot:execution handler's
  // incremental updates consistent with what a page refresh would show.
  window.BOT_INITIAL_POSITION = <%- JSON.stringify(typeof currentPosition !== 'undefined' ? currentPosition : null) %>;
  window.BOT_PERFORMANCE = <%- JSON.stringify(typeof performanceData !== 'undefined' ? performanceData : null) %>;

  // NOVA TRADE -- PART 10: closed Trade documents, reused as-is from the
  // same authoritative, instanceId+environment-scoped query already run
  // for the Trade History tab (controllers/botController.js `initialTrades`)
  // -- no separate markers endpoint. Consumed by bot-detail-chart.js to
  // reconstruct real historical BUY/SELL/EXIT markers on page load.
  window.BOT_INITIAL_TRADES = <%- JSON.stringify(typeof initialTrades !== 'undefined' ? initialTrades : []) %>;
</script>

<!-- New UI wiring: tabs, control center, mirrors, icons. Does not touch bot-detail-ws.js logic. -->
<script>
  function switchTab(name) {
    document.querySelectorAll('.tab-btn').forEach(function(btn) {
      btn.setAttribute('data-active', btn.getAttribute('data-tab') === name ? 'true' : 'false');
    });
    document.querySelectorAll('.tab-panel').forEach(function(panel) {
      panel.setAttribute('data-active', panel.getAttribute('data-tab') === name ? 'true' : 'false');
    });
  }

  function toggleAdvancedSettings() {
    var el = document.getElementById('adv-settings');
    var chevron = document.getElementById('adv-chevron');
    var open = el.getAttribute('data-open') === 'true';
    el.setAttribute('data-open', open ? 'false' : 'true');
    if (chevron) chevron.style.transform = open ? 'rotate(0deg)' : 'rotate(180deg)';
  }

  // Control Center actions — wired to the real API, same pattern as the
  // dashboard's bot-card buttons (NovaApi.post to /api/bots/:id/<action>).
  function showCtlToast(msg, isError) {
    var toast = document.getElementById('ctl-toast');
    if (!toast) return;
    toast.textContent = msg;
    toast.className = 'text-[11px] transition-opacity ' + (isError ? 'text-rose-400' : 'text-gray-400');
    toast.style.opacity = '1';
    clearTimeout(window.__ctlToastTimer);
    window.__ctlToastTimer = setTimeout(function() { toast.style.opacity = '0'; }, 3200);
  }

  function collectConfigPayload() {
    var val = function(id) {
      var el = document.getElementById(id);
      return el ? el.value : null;
    };
    // NOVA TRADE -- BOT DETAIL CLEANUP: emaLength/breakoutLookback/
    // minBodyRatio/levels/targets/sizing are obsolete-model-only configuration.
    // MODEL_002 trend/support/resistance are handled in the isModel002
    // branch below — collected only when the user actually touched them
    // (all 3 of an array filled, matching the existing "don't overwrite
    // with blanks" convention used for levels/targets above).
    var payload = {
      capital: val('ctl-capital'),
      riskPct: val('ctl-risk'),
      leverage: val('ctl-leverage'),
      timeframe: val('ctl-timeframe')
    };

    var isModel002 = window.BOT_CONFIG && window.BOT_CONFIG.modelId === 'MODEL_002';
    if (isModel002) {
      var trendEl = document.getElementById('ctl-m002-trend');
      if (trendEl) payload.trend = trendEl.value;

      var supportVals = [val('ctl-m002-support-0'), val('ctl-m002-support-1'), val('ctl-m002-support-2')];
      if (supportVals.every(function(v) { return v !== null && v !== ''; })) {
        payload.support = supportVals.map(Number);
      }

      var resistanceVals = [val('ctl-m002-resistance-0'), val('ctl-m002-resistance-1'), val('ctl-m002-resistance-2')];
      if (resistanceVals.every(function(v) { return v !== null && v !== ''; })) {
        payload.resistance = resistanceVals.map(Number);
      }
    } else {
      payload.emaLength = val('ctl-ema-length');
      payload.breakoutLookback = val('ctl-breakout-lookback');
      payload.minBodyRatio = val('ctl-body-ratio');

      var topLevel = val('ctl-top-level');
      var bottomLevel = val('ctl-bottom-level');
      if (topLevel !== null && topLevel !== '' && bottomLevel !== null && bottomLevel !== '') {
        payload.levels = { top: Number(topLevel), bottom: Number(bottomLevel) };
      }

      var targetsRaw = val('ctl-targets');
      if (targetsRaw !== null && targetsRaw.trim() !== '') {
        payload.targets = targetsRaw.split(',').map(function(s) { return s.trim(); }).filter(Boolean).map(function(s) { return { price: Number(s) }; });
      }

      var sizingModeEl = document.getElementById('ctl-sizing-mode');
      if (sizingModeEl) {
        var lotValue = val('ctl-lot-value');
        payload.sizing = sizingModeEl.value === 'LOT'
          ? { mode: 'LOT', value: Number(lotValue) }
          : { mode: 'CAPITAL' };
      }
    }

    return payload;
  }

  // Falls back to a plain fetch (same endpoint shape) if NovaApi isn't loaded
  // on this page yet, so the buttons work either way.
  async function apiPost(url, body) {
    if (typeof NovaApi !== 'undefined' && NovaApi.post) {
      return NovaApi.post(url, body);
    }
    var res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: body ? JSON.stringify(body) : undefined
    });
    var text = await res.text();
    var parsed;
    try { parsed = JSON.parse(text); } catch (e) { parsed = text; }
    if (!res.ok) {
      var msg = (parsed && (parsed.message || parsed.error)) || ('Request failed: ' + res.status);
      throw new Error(msg);
    }
    return parsed;
  }

  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('[data-action]');
    if (!btn || !btn.closest('#control-center')) return;

    const action = btn.dataset.action;
    const instanceId = window.BOT_CONFIG && window.BOT_CONFIG.instanceId;
    if (!instanceId) {
      showCtlToast('Missing instance id — cannot reach the API.', true);
      return;
    }

    btn.disabled = true;
    try {
      switch (action) {
        case 'start':
          setPendingStatus('STARTING');
          await apiPost(`/api/bot-instances/${instanceId}/start`);
          break;
        case 'pause':
          setPendingStatus('PAUSING');
          await apiPost(`/api/bot-instances/${instanceId}/pause`);
          break;
        case 'stop':
          setPendingStatus('STOPPING');
          await apiPost(`/api/bot-instances/${instanceId}/stop`);
          break;
        case 'restart':
          setPendingStatus('RESTARTING');
          await apiPost(`/api/bot-instances/${instanceId}/restart`);
          break;
        case 'save':
          await apiPost(`/api/bot-instances/${instanceId}/config`, collectConfigPayload());
          break;
        default:
          btn.disabled = false;
          return;
      }
      showCtlToast(action.charAt(0).toUpperCase() + action.slice(1) + ' request sent.');
      setTimeout(() => {
  window.location.reload();
}, 800);
    } catch (err) {
      console.error(err);
      // PART 11 — PHASE V: an API failure must not leave the UI implying
      // the action succeeded (e.g. showing RUNNING after Start actually
      // failed) — revert the button state machine to what the backend
      // told us at page load, since we never actually transitioned.
      applyButtonStateForStatus(window.BOT_CONFIG.status);
      showCtlToast((err && err.message) || 'Request failed — check console.', true);
    } finally {
      btn.disabled = false;
    }
  });

  // =========================================================
  // PART 11 — PHASE N/X: CONTROL CENTER BUTTON STATE MACHINE
  // =========================================================
  //
  // Buttons must reflect the backend-authoritative BotInstance.status, not
  // just "was I just clicked". This runs once at page load (from the
  // server-rendered bot.status) and again on every `bot:status` socket
  // event for this instance, so a status change from another tab/device
  // (or from the backend rejecting a request) is reflected without
  // requiring a manual refresh.
  function applyButtonStateForStatus(status) {
    const startBtn = document.getElementById('ctl-start-btn');
    const pauseBtn = document.getElementById('ctl-pause-btn');
    const stopBtn = document.getElementById('ctl-stop-btn');
    const restartBtn = document.getElementById('ctl-restart-btn');
    const timeframeInput = document.getElementById('ctl-timeframe');

    const map = {
      RUNNING:   { start: true,  pause: false, stop: false, restart: false },
      PAUSED:    { start: false, pause: true,  stop: false, restart: false },
      STOPPED:   { start: false, pause: true,  stop: true,  restart: false },
      ERROR:     { start: false, pause: true,  stop: false, restart: false },
      // Transient client-side states while an API call is in flight —
      // disable everything so a second click can't race the first.
      STARTING:   { start: true, pause: true, stop: true, restart: true },
      PAUSING:    { start: true, pause: true, stop: true, restart: true },
      STOPPING:   { start: true, pause: true, stop: true, restart: true },
      RESTARTING: { start: true, pause: true, stop: true, restart: true },
    };
    const s = map[status] || map.STOPPED;

    if (startBtn) startBtn.disabled = s.start;
    if (pauseBtn) pauseBtn.disabled = s.pause;
    if (stopBtn) stopBtn.disabled = s.stop;
    if (restartBtn) restartBtn.disabled = s.restart;

    // Timeframe can only be changed while the bot is not RUNNING (see
    // BotManager.updateConfiguration — the backend rejects it otherwise).
    if (timeframeInput) {
      const locked = status === 'RUNNING';
      timeframeInput.readOnly = locked;
      timeframeInput.classList.toggle('opacity-60', locked);
      timeframeInput.classList.toggle('cursor-not-allowed', locked);
      timeframeInput.title = locked ? 'Pause or stop the bot to change timeframe' : '';
    }
  }

  function setPendingStatus(status) {
    window.BOT_CONFIG.status = status;
    applyButtonStateForStatus(status);
  }

  // =========================================================
  // ACTIVE ANALYSIS TIMEFRAME (one-time opposite-market switch)
  // =========================================================
  //
  // Purely a display + retarget concern: the switch itself is decided by
  // MODEL_002 and persisted by BotManager. This only makes sure the page
  // never keeps showing the configured timeframe after the bot has really
  // moved to 1m, and repoints the existing countdown at the new timeframe
  // (NovaNextCandle.setTimeframe — the same single timer, not a new one).
  function renderActiveTimeframe(data) {
    if (!data || data.timeframeSwitched !== true || !data.activeTimeframe) return;
    if (window.BOT_CONFIG.activeTimeframe === data.activeTimeframe && window.BOT_CONFIG.timeframeSwitched) return;

    window.BOT_CONFIG.activeTimeframe = data.activeTimeframe;
    window.BOT_CONFIG.timeframeSwitched = true;

    const row = document.getElementById('active-timeframe-row');
    const val = document.getElementById('active-timeframe-value');
    if (val) val.textContent = data.activeTimeframe;
    if (row) row.classList.remove('hidden');

    if (window.NovaNextCandle && window.NovaNextCandle.current) {
      window.NovaNextCandle.current.setTimeframe(data.activeTimeframe);
    }
  }

  // =========================================================
  // NEXT CANDLE COUNTDOWN (PART 11 — PHASE H, reworked)
  // =========================================================
  //
  // Previously this block ran its own setInterval over `Date.now()`, i.e.
  // the browser's local clock. Nova Trade's candles are bucketed from Delta
  // Exchange tick timestamps by CandlePersistenceService, so a skewed client
  // clock produced a countdown that disagreed with the candles actually being
  // persisted and traded.
  //
  // The calculation now lives in ONE place (public/js/next-candle-countdown.js)
  // and is driven by the authoritative server/exchange clock:
  //   * the EXISTING `market:price` event's Delta ticker timestamp
  //   * GET /api/market/time for bootstrap / periodic resync
  // A single interval renders BOTH the on-chart card and this right-panel
  // metric, so the two can never show different values.
  // Deferred to DOMContentLoaded because this inline block executes BEFORE
  // the <script src> tags at the end of <body> (bot-socket.js /
  // next-candle-countdown.js) have run.
  document.addEventListener('DOMContentLoaded', function initNextCandleCountdown() {
    if (!window.NovaNextCandle) return; // never break the page if the script is absent
    window.NovaNextCandle.init({
      timeframe: window.BOT_CONFIG && (window.BOT_CONFIG.activeTimeframe || window.BOT_CONFIG.timeframe),
      symbol: window.BOT_CONFIG && window.BOT_CONFIG.pair,
      instanceId: window.BOT_CONFIG && window.BOT_CONFIG.instanceId,
      socket: window.NovaBotSocket, // the shared connection — no second socket
      elementIds: ['stat-next-candle', 'chart-next-candle'],
    });
    // Cleanup: no orphan interval / socket listeners when leaving the page.
    window.addEventListener('pagehide', function () { window.NovaNextCandle.destroy(); });
  });

  // =========================================================
  // PART 11 — PHASE F: STRATEGY READINESS DISPLAY
  // =========================================================
  //
  // Renders BotManager's real, in-memory readiness state (HYDRATING /
  // READY / INSUFFICIENT_HISTORY / ERROR) so "RUNNING" never has to imply
  // "actively producing real decisions" on its own — see the `bot:readiness`
  // socket event emitted by BotManager._setReadiness.
  function renderStrategyReadiness(r) {
    const el = document.getElementById('stat-bot-health');
    if (!el || !r) return;
    let label = 'Monitoring';
    let cls = 'text-emerald-400';
    if (r.state === 'HYDRATING') { label = 'Hydrating history'; cls = 'text-blue-400'; }
    else if (r.state === 'BACKFILLING') { label = 'Loading market history...'; cls = 'text-blue-400'; }
    else if (r.state === 'INSUFFICIENT_HISTORY') { label = `${r.have || 0} / ${r.required || 0} candles`; cls = 'text-amber-400'; }
    else if (r.state === 'ERROR') { label = 'Strategy error'; cls = 'text-rose-400'; }
    else if (r.state === 'READY') { label = 'Monitoring'; cls = 'text-emerald-400'; }
    el.className = 'inline-flex items-center gap-1 text-[10px] ' + cls;
    el.innerHTML = '<i data-lucide="heart-pulse" class="w-3 h-3"></i> ' + label;
    if (window.lucide) lucide.createIcons();
  }

  document.addEventListener('DOMContentLoaded', function() {
    applyButtonStateForStatus(window.BOT_CONFIG.status);

    if (window.NovaBotSocket) {
      // PART 11 — PHASE P: reuse the shared socket connection (never open a
      // second io()); scope every handler to this instanceId only, same
      // pattern as every other bot:* listener in bot-detail-ws.js.
      window.NovaBotSocket.on('bot:status', function(data) {
        if (!data || data.instanceId !== window.BOT_CONFIG.instanceId) return;
        window.BOT_CONFIG.status = data.status;
        applyButtonStateForStatus(data.status);
        // ONE-TIME OPPOSITE-MARKET SWITCH: bot:status now also carries
        // activeTimeframe/timeframeSwitched (see BotManager._broadcastStatus).
        // No new event and no second socket — this handler already exists.
        renderActiveTimeframe(data);
        const badge = document.getElementById('bot-status-badge');
        if (badge) {
          badge.textContent = data.status;
          badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold ' +
            (data.status === 'RUNNING' ? 'bg-emerald-950 text-emerald-400 border border-emerald-800' : 'bg-amber-950 text-amber-400 border border-amber-800');
        }
      });

      window.NovaBotSocket.on('bot:readiness', function(data) {
        if (!data || data.instanceId !== window.BOT_CONFIG.instanceId) return;
        renderStrategyReadiness(data);
      });

      // PART 11 — PHASE P: one lightweight state refresh after reconnect —
      // re-pull authoritative status/readiness instead of trusting
      // whatever the UI last rendered before the drop.
      window.NovaBotSocket.on('connect', function() {
        fetch(`/api/bot-instances/${window.BOT_CONFIG.instanceId}`, { credentials: 'include' })
          .then((r) => r.json())
          .then((body) => {
            const data = body && body.data;
            if (!data) return;
            window.BOT_CONFIG.status = data.status;
            applyButtonStateForStatus(data.status);
            if (data.strategyReadiness) renderStrategyReadiness(data.strategyReadiness);
          })
          .catch(() => {});
      });
    }
  });



  // PART 13 -- PHASE P: show the Lot/Contract Quantity field only when
  // Sizing Mode is LOT, matching the Create Bot form's same behavior.
  document.addEventListener('DOMContentLoaded', function() {
    var sizingModeEl = document.getElementById('ctl-sizing-mode');
    var lotValueFieldEl = document.getElementById('ctl-lot-value-field');
    if (sizingModeEl && lotValueFieldEl) {
      sizingModeEl.addEventListener('change', function() {
        lotValueFieldEl.style.display = sizingModeEl.value === 'LOT' ? '' : 'none';
      });
    }
  });

  // Log filter (client-side, non-destructive; works on whatever bot-detail-ws.js renders
  // into #log-terminal as long as entries carry their level as visible text, e.g. "[ORDER]").
  document.addEventListener('DOMContentLoaded', function() {
    var buttons = document.querySelectorAll('.log-filter-btn');
    buttons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        buttons.forEach(function(b) { b.classList.remove('bg-blue-500/20', 'text-blue-400', 'border-blue-500/30'); });
        btn.classList.add('bg-blue-500/20', 'text-blue-400', 'border-blue-500/30');
        var filter = btn.getAttribute('data-filter');
        var terminal = document.getElementById('log-terminal');
        if (!terminal) return;
        Array.prototype.forEach.call(terminal.children, function(line) {
          if (filter === 'ALL' || line.textContent.indexOf('[' + filter + ']') !== -1) {
            line.style.display = '';
          } else {
            line.style.display = 'none';
          }
        });
      });
    });

    if (window.lucide) lucide.createIcons();
  });

  // Keep the compact hero Win Rate mirror in sync with the canonical
  // Performance-tab element, without changing how that element itself is
  // updated by bot-detail-ws.js.
  //
  // NOVA TRADE -- PART 9: the old "Today's Profit" mirror (perf-total-pnl
  // -> perf-total-pnl-mirror) has been removed. It was silently displaying
  // all-time Total Profit under a "Today's Profit" label; Today's Profit
  // now has its own server-computed value (#stat-today-profit, see
  // controllers/botController.js) and must never be re-mirrored from
  // Total Profit.
  (function observeMirrors() {
    var pairs = [
      ['perf-winrate', 'perf-winrate-mirror', 'text']
    ];
    var MutationObs = window.MutationObserver;
    if (!MutationObs) return;
    pairs.forEach(function(pair) {
      var source = document.getElementById(pair[0]);
      var mirror = document.getElementById(pair[1]);
      if (!source || !mirror) return;
      var sync = function() { mirror.textContent = source.textContent.replace('$', ''); };
      sync();
      new MutationObs(sync).observe(source, { childList: true, characterData: true, subtree: true });
    });
  })();
</script>

