              <div class="text-sm font-bold font-mono mt-1 <%= (bot.parameters && bot.parameters.trend === 'BULLISH') ? 'text-emerald-400' : (bot.parameters && bot.parameters.trend === 'BEARISH') ? 'text-rose-400' : 'text-gray-200' %>"><%= (bot.parameters && bot.parameters.trend) || '--' %></div>
            </div>
            <div class="glass-tight rounded-xl p-3 text-center">
              <div class="text-[10px] text-gray-500 uppercase">Timeframe</div>
              <div class="text-sm font-bold font-mono text-gray-200 mt-1"><%= (bot.parameters && bot.parameters.timeframe) || '--' %></div>
              <!-- ONE-TIME OPPOSITE-MARKET SWITCH: the user's configured
                   timeframe above never changes; this line appears only once
                   the bot has actually switched, so the page can never show
                   a stale "3m" while the bot is really analysing 1m. -->
              <div id="active-timeframe-row" class="mt-1 <%= (bot.parameters && bot.parameters.timeframeSwitched === true) ? '' : 'hidden' %>">
                <div class="text-[10px] text-gray-500 uppercase">Active</div>
