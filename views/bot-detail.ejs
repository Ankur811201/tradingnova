<script>
(function(){
  var instanceId = <%- JSON.stringify(bot.instanceId) %>;
  var side = <%- JSON.stringify((typeof currentPosition !== 'undefined' && currentPosition) ? currentPosition.side : null) %>;
  var wrap=document.getElementById('target-form-wrap'), noPos=document.getElementById('target-no-position');
  var btn=document.getElementById('target-activate-btn'), err=document.getElementById('target-error'), status=document.getElementById('target-exit-status');
  function showError(m){ if(!err)return; err.textContent=m||''; err.classList.toggle('hidden',!m); }
  function pctSum(){ return [1,2,3].reduce(function(s,i){return s+Number(document.getElementById('target-percent-'+i)?.value||0);},0); }
  function refresh(){
    fetch('/api/bot-instances/'+encodeURIComponent(instanceId)+'/target-exit',{credentials:'include'}).then(function(r){return r.json();}).then(function(body){
      if(!body || body.success!==true) return;
      var d=body.data||{}; var pos=d.position; var plan=d.plan;
      var has=!!pos;
      if(wrap) wrap.classList.toggle('hidden',!has); if(noPos) noPos.classList.toggle('hidden',has);
      if(!has){ if(status) status.textContent='No open position'; return; }
      if(plan && plan.targets){
        if(status) status.textContent=plan.enabled?'ACTIVE · 3-CANDLE WINDOW':'No active plan';
        plan.targets.forEach(function(t,i){ var st=document.getElementById('target-state-'+(i+1)); if(st) st.textContent=(t.status||'WAITING').replace('_',' '); var inp=document.getElementById('target-price-'+(i+1)); if(inp && document.activeElement!==inp) inp.value=t.price; if(i<3){var p=document.getElementById('target-percent-'+(i+1));if(p&&document.activeElement!==p)p.value=t.exitPercent;} });
        var rem=document.getElementById('target-t4-remaining'); if(rem) rem.textContent=(plan.targets[3]?.exitPercent||10)+'%';
        if(btn) btn.disabled=!!plan.enabled;
        for(var li=1;li<=4;li++){var pi=document.getElementById('target-price-'+li);if(pi)pi.disabled=!!plan.enabled; if(li<4){var ei=document.getElementById('target-percent-'+li);if(ei)ei.disabled=!!plan.enabled;}}
        if(window.NovaTargetOverlaySync) window.NovaTargetOverlaySync(plan.targets);
      } else { if(status) status.textContent='No active plan'; if(btn) btn.disabled=false; }
    }).catch(function(){});
  }
  if(btn) btn.addEventListener('click',function(){
    showError(''); var prices=[1,2,3,4].map(function(i){return Number(document.getElementById('target-price-'+i).value);}); var perc=[1,2,3].map(function(i){return Number(document.getElementById('target-percent-'+i).value);});
    if(prices.some(function(x){return !Number.isFinite(x)||x<=0;})){showError('Enter all 4 valid target prices.');return;}
    if(perc.some(function(x){return !Number.isFinite(x)||x<=0;})){showError('Enter valid T1-T3 percentages.');return;}
    if(Math.abs(perc.reduce(function(a,b){return a+b;},0)-90)>1e-9){showError('T1 + T2 + T3 must equal 90%.');return;}
    var payload={enabled:true,targets:prices.map(function(p,i){return {price:p,exitPercent:i<3?perc[i]:null};})};
    btn.disabled=true; btn.textContent='Activating…';
    fetch('/api/bot-instances/'+encodeURIComponent(instanceId)+'/target-exit',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'include',body:JSON.stringify(payload)}).then(function(r){return r.json().then(function(b){if(!r.ok||!b.success)throw new Error(b.message||'Unable to activate target exit');return b;});}).then(function(){refresh();}).catch(function(e){showError(e.message);btn.disabled=false;}).finally(function(){btn.innerHTML='<i data-lucide="target" class="w-3.5 h-3.5"></i> Activate Target Exit'; if(window.lucide)window.lucide.createIcons();});
  });
  refresh(); setInterval(refresh,2000);
})();
</script>
