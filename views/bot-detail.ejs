                      <td class="py-2.5 pr-3 font-bold <%= trade.realizedPnl >= 0 ? 'text-emerald-400' : 'text-rose-400' %>">$<%= trade.realizedPnl.toFixed(2) %></td>
                      <td class="py-2.5 text-gray-400 text-[10px]"><%= trade.reason || 'N/A' %></td>
                    </tr>
                  <% }) %>
                <% } else { %>
