            <div class="glass-tight rounded-xl p-3 text-center">
              <div class="text-[10px] text-gray-500 uppercase">Support (S1/S2/S3)</div>
              <div class="text-sm font-bold font-mono text-gray-200 mt-1"><%= (bot.parameters && Array.isArray(bot.parameters.support) && bot.parameters.support.length) ? bot.parameters.support.join(' / ') : '--' %></div>
            </div>
            <div class="glass-tight rounded-xl p-3 text-center">
              <div class="text-[10px] text-gray-500 uppercase">Resistance (R1/R2/R3)</div>
              <div class="text-sm font-bold font-mono text-gray-200 mt-1"><%= (bot.parameters && Array.isArray(bot.parameters.resistance) && bot.parameters.resistance.length) ? bot.parameters.resistance.join(' / ') : '--' %></div>
            </div>
