<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/styles.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'ui-sans-serif', 'system-ui'],
            display: ['"Space Grotesk"', 'ui-sans-serif', 'system-ui'],
            mono: ['"JetBrains Mono"', 'ui-monospace', 'SFMono-Regular', 'Menlo', 'monospace'],
          },
        }
      }
    }
  </script>
  <script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>

  <style>
    body { background-color: #05060a; }
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(1200px 600px at 85% -10%, rgba(59,130,246,0.10), transparent 60%),
        radial-gradient(900px 500px at 5% 10%, rgba(16,185,129,0.06), transparent 60%);
      z-index: 0;
    }
    .glass {
      background: linear-gradient(180deg, rgba(255,255,255,0.035), rgba(255,255,255,0.012));
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(255,255,255,0.07);
    }
    .glass-tight {
      background: rgba(255,255,255,0.025);
      border: 1px solid rgba(255,255,255,0.06);
    }
    .glow-emerald { box-shadow: 0 0 0 1px rgba(16,185,129,0.25), 0 0 24px -6px rgba(16,185,129,0.35); }
    .glow-rose { box-shadow: 0 0 0 1px rgba(244,63,94,0.25), 0 0 24px -6px rgba(244,63,94,0.35); }
    .glow-amber { box-shadow: 0 0 0 1px rgba(245,158,11,0.25), 0 0 24px -6px rgba(245,158,11,0.35); }
    .glow-blue { box-shadow: 0 0 0 1px rgba(59,130,246,0.25), 0 0 24px -6px rgba(59,130,246,0.35); }

    .scrollbar-thin::-webkit-scrollbar { width: 6px; height: 6px; }
    .scrollbar-thin::-webkit-scrollbar-track { background: transparent; }
    .scrollbar-thin::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.10); border-radius: 999px; }
    .scrollbar-thin::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.18); }

    .tab-btn { position: relative; }
    .tab-btn[data-active="true"] { color: #fff; }
    .tab-btn[data-active="true"]::after {
      content: '';
      position: absolute;
      left: 0; right: 0; bottom: -1px;
      height: 2px;
      background: linear-gradient(90deg, #3b82f6, #10b981);
      border-radius: 2px;
    }
    .tab-panel { display: none; }
    .tab-panel[data-active="true"] { display: block; animation: fadein .18s ease; }
    @keyframes fadein { from { opacity: 0; transform: translateY(2px); } to { opacity: 1; transform: translateY(0); } }

    .timeline-track { position: relative; }
    .timeline-track::before {
      content: '';
      position: absolute;
      left: 9px; top: 4px; bottom: 4px;
      width: 1px;
      background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.14), rgba(255,255,255,0.02));
    }
    @media (min-width: 640px) {
      .timeline-track-h::before { display:none; }
    }

    #adv-settings { max-height: 0; overflow: hidden; transition: max-height .28s ease; }
    #adv-settings[data-open="true"] { max-height: 480px; }

    #ctl-toast {
      transition: opacity .25s ease, transform .25s ease;
    }
  </style>
</head>
<body class="bg-transparent text-gray-100 font-sans antialiased flex flex-col min-h-screen relative">

  <!-- HEADER -->
  <header class="sticky top-0 z-40 glass border-b border-white/5 px-4 sm:px-6 py-3 flex items-center justify-between backdrop-blur-xl">
    <div class="flex items-center gap-4 min-w-0">
      <a href="/dashboard" class="text-gray-400 hover:text-white transition flex items-center gap-1 text-sm shrink-0">
        <i data-lucide="chevron-left" class="w-4 h-4"></i><span class="hidden sm:inline">Dashboard</span>
      </a>
      <div class="w-px h-6 bg-white/10 hidden sm:block"></div>
      <h1 class="text-lg sm:text-xl font-display font-semibold tracking-tight text-white flex items-center gap-2 min-w-0">
        <span class="truncate"><%= bot.name %></span>
        <span class="text-[11px] shrink-0 bg-blue-500/10 text-blue-400 border border-blue-500/25 px-2 py-0.5 rounded-md font-mono"><%= bot.modelId === 'MODEL_002' ? 'MODEL_002 — Custom Pattern' : (bot.modelId || 'MODEL UNKNOWN') %></span>
      </h1>
    </div>
    <div class="flex items-center gap-3 sm:gap-6 text-sm">
      <div class="hidden md:flex items-center gap-6">
        <div>
          <span class="text-gray-500 text-xs">Pair</span>
          <div class="font-semibold text-gray-200 font-mono"><%= bot.symbol || bot.tradingPair || 'N/A' %></div>
        </div>
        <div>
          <span class="text-gray-500 text-xs">Mode</span>
          <div class="font-semibold text-gray-200 uppercase"><%= bot.environment || bot.tradingMode || 'N/A' %></div>
        </div>
        <div>
          <span class="text-gray-500 text-xs">Capital</span>
          <div class="font-semibold font-mono text-emerald-400">$<%= Number(bot.capitalAllocation || bot.capital || 0).toLocaleString() %></div>
        </div>
      </div>
      <span id="bot-status-badge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold <%= bot.status === 'RUNNING' ? 'bg-emerald-950 text-emerald-400 border border-emerald-800' : 'bg-amber-950 text-amber-400 border border-amber-800' %>">
        <span class="w-1.5 h-1.5 rounded-full <%= bot.status === 'RUNNING' ? 'bg-emerald-400 animate-pulse' : 'bg-amber-400' %>"></span>
        <%= bot.status %>
      </span>
    </div>
  </header>

  <!-- MAIN -->
  <main class="relative z-10 flex-1 p-3 sm:p-4 max-w-[1920px] mx-auto w-full space-y-4">

    <!-- ================= SECTION 1: HERO ================= -->
    <div class="grid grid-cols-12 gap-4">

      <!-- LEFT 70%: CHART + TIMELINE -->
      <section class="col-span-12 lg:col-span-8 xl:col-span-9 flex flex-col gap-4">
        <div class="glass rounded-2xl flex flex-col min-h-[520px] overflow-hidden">
          <div class="px-4 py-3 border-b border-white/5 flex justify-between items-center bg-black/10 text-xs">
            <span class="font-semibold text-gray-300 uppercase tracking-wider flex items-center gap-2">
              <i data-lucide="candlestick-chart" class="w-3.5 h-3.5 text-blue-400"></i> Live Chart &amp; Active Overlays
            </span>
            <div class="flex items-center gap-4">
              <div class="hidden sm:flex items-center gap-3 font-mono text-[11px] text-gray-400">
                <span>24h <span id="market-change">--</span></span>
                <span class="w-px h-3 bg-white/10"></span>
                <span>Spread <span id="market-spread">--</span></span>
              </div>
              <button id="chart-fullscreen-btn"
                      type="button"
                      class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-white/10 bg-white/[0.03] text-gray-400 hover:text-white hover:bg-white/[0.07] hover:border-white/20 transition text-[11px] font-semibold"
                      aria-label="Open chart full screen"
                      title="Full screen chart">
                <i data-lucide="maximize-2" class="w-3.5 h-3.5"></i>
                <span class="hidden sm:inline" id="chart-fullscreen-label">Full screen</span>
              </button>
              <div id="chart-recording-status" class="hidden text-rose-400 font-mono text-[10px] font-semibold animate-pulse">● RECORDING 1 FPS</div>
              <div id="chart-connection-status" class="flex items-center gap-1.5 text-emerald-400">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Dynamic Stream Active
              </div>
            </div>
          </div>
          <div id="bot-chart-panel" class="w-full flex-1 min-h-[460px] relative">
            <div id="bot-chart-container" class="w-full h-full"></div>
            <div id="bot-chart-state" class="absolute inset-0 flex items-center justify-center text-xs text-gray-500 font-mono pointer-events-none">
              Loading market candles...
            </div>
            <!-- PRICE-AXIS LABEL (TradingView style): one compact label
                 pinned to the RIGHT PRICE AXIS carrying the live price
                 (larger) and the next-candle countdown (smaller) — no
                 English labels, no icon. `top` is set in pixels by
                 chart-price-label.js from series.priceToCoordinate(price),
                 never a fixed percentage, so it tracks the actual price
                 level through zoom/scroll/autoscale/resize. Hidden until
                 the first real price arrives. #chart-next-candle is written
                 by the existing next-candle-countdown.js render pass; the
                 price by the existing market:price handler. -->
            <div id="chart-price-label"
                 class="hidden absolute right-0 z-10 pointer-events-none -translate-y-1/2
                        rounded-md border border-emerald-400/30 bg-[#0b1220]/95
                        px-2 py-1 text-center leading-tight shadow-lg">
              <div class="text-xs font-bold font-mono text-white" id="chart-current-price">--</div>
              <div class="text-[10px] font-semibold font-mono text-emerald-400" id="chart-next-candle">--:--</div>
            </div>
          </div>
        </div>

        <!-- Live Trade Timeline -->
        <div class="glass rounded-2xl p-4">
          <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3 flex items-center gap-2">
            <i data-lucide="git-commit-horizontal" class="w-3.5 h-3.5"></i> Live Trade Story
          </h2>
          <!-- NOVA TRADE -- PART 15 PHASE B/STEP 5: sourced from real
               StrategyEvent (DECISION) + Trade + Position data (see
               utils/tradeStory.js), instead of the legacy Signal
               collection, which has had zero writers since Part 7. New
               steps are also prepended live from position:opened,
               position:closed, trade:created, risk:rejected, and
               trade:rejected -- see public/js/bot-detail-ws.js. -->
          <div id="trade-timeline" class="timeline-track sm:timeline-track-h flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-0 pl-6 sm:pl-0 text-xs font-mono">
            <%
              var toneClass = {
                buy: 'bg-emerald-400', sell: 'bg-rose-400',
                profit: 'bg-emerald-400', loss: 'bg-rose-400',
                reject: 'bg-amber-400',
              };
              var storySteps = (typeof initialTradeStory !== 'undefined' && initialTradeStory) ? initialTradeStory : [];
            %>
            <% if (storySteps.length) { %>
              <% storySteps.forEach(function(step, i) { %>
                <div class="relative flex items-center gap-2 sm:flex-1">
                  <span class="w-2.5 h-2.5 rounded-full shrink-0 -ml-6 sm:ml-0 <%= toneClass[step.tone] || 'bg-amber-400' %>"></span>
                  <div class="glass-tight rounded-lg px-3 py-2 flex-1">
                    <div class="text-gray-200 font-semibold"><%= step.label %></div>
                    <div class="text-gray-500 text-[10px] truncate max-w-[160px]"><%= step.detail %></div>
                  </div>
                  <% if (i < storySteps.length - 1) { %>
                    <i data-lucide="chevron-right" class="hidden sm:block w-4 h-4 text-gray-600 shrink-0"></i>
                  <% } %>
                </div>
              <% }) %>
            <% } else { %>
              <div class="text-gray-500 italic py-2">No executed trades yet.</div>
            <% } %>
          </div>
        </div>
      </section>

      <!-- RIGHT 30%: STATUS CARDS -->
      <section class="col-span-12 lg:col-span-4 xl:col-span-3 flex flex-col gap-4">

        <!-- Decision Engine (Status + Current Decision + Why) -->
        <div class="glass rounded-2xl p-4">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wider flex items-center gap-2">
              <i data-lucide="brain-circuit" class="w-3.5 h-3.5"></i> Bot Decision Engine
            </h2>
            <div class="flex items-center gap-3">

  <span id="decision-last-update"
        class="text-[10px] text-gray-500 font-mono">
    Waiting for engine...
  </span>

  <span id="stat-bot-health"
        class="inline-flex items-center gap-1 text-[10px] <%
          var srClass = 'text-emerald-400';
          var srLabel = 'Monitoring';
          if (typeof strategyReadiness !== 'undefined' && strategyReadiness) {
            if (strategyReadiness.state === 'HYDRATING') { srClass = 'text-blue-400'; srLabel = 'Hydrating history'; }
            else if (strategyReadiness.state === 'BACKFILLING') { srClass = 'text-blue-400'; srLabel = 'Loading market history...'; }
            else if (strategyReadiness.state === 'INSUFFICIENT_HISTORY') { srClass = 'text-amber-400'; srLabel = (strategyReadiness.have || 0) + ' / ' + (strategyReadiness.required || 0) + ' candles'; }
            else if (strategyReadiness.state === 'ERROR') { srClass = 'text-rose-400'; srLabel = 'Strategy error'; }
            else if (strategyReadiness.state === 'NOT_RUNNING') { srClass = 'text-gray-400'; srLabel = 'Not running'; }
          }
        %><%= srClass %>">
    <i data-lucide="heart-pulse" class="w-3 h-3"></i>
    <%= srLabel %>
  </span>

</div>
          </div>
          <div id="thinking-container" class="flex flex-col gap-3">
            <div id="thinking-checks" class="space-y-2 text-xs">
              <div class="text-gray-500 italic">Awaiting decision frame...</div>
            </div>
            <div class="glow-blue p-3 bg-black/30 border border-white/5 rounded-xl">
              <div class="text-[10px] text-gray-400 font-semibold mb-1 uppercase tracking-wide">Final Decision</div>
              <div id="thinking-decision" class="text-2xl font-display font-bold text-blue-400 uppercase leading-none mb-2">--</div>
              <p id="thinking-reason" class="text-xs text-gray-300 leading-relaxed font-mono">Initializing execution context...</p>
            </div>
          </div>
        </div>

        <!-- Quick Stat Grid -->
        <div class="grid grid-cols-2 gap-3">
          <div class="glass-tight rounded-xl p-3">
            <div class="text-[10px] text-gray-500 uppercase tracking-wide mb-1">Current PnL</div>
            <div id="pos-pnl-mirror" class="text-sm font-bold font-mono text-gray-200">
              <% if (typeof currentPosition !== 'undefined' && currentPosition) { %>
                <span class="<%= currentPosition.unrealizedPnl >= 0 ? 'text-emerald-400' : 'text-rose-400' %>">$<%= currentPosition.unrealizedPnl.toFixed(2) %></span>
              <% } else { %>--<% } %>
            </div>
          </div>
          <div class="glass-tight rounded-xl p-3">
            <div class="text-[10px] text-gray-500 uppercase tracking-wide mb-1">Today's Profit</div>
            <!-- NOVA TRADE -- PART 9: real realized PnL for trades closed
                 today (server-local day boundary), computed in
                 controllers/botController.js via utils/performance.js.
                 Deliberately NOT the same value as the Performance tab's
                 all-time "Total Profit" -- the two used to be conflated via
                 a DOM mirror; that mirror has been removed. -->
            <div id="stat-today-profit" class="text-sm font-bold font-mono <%= (typeof performanceData !== 'undefined' && performanceData && performanceData.todayProfit >= 0) ? 'text-emerald-400' : 'text-rose-400' %>">
              $<%= typeof performanceData !== 'undefined' && performanceData ? performanceData.todayProfit.toFixed(2) : '0.00' %>
            </div>
          </div>
          <div class="glass-tight rounded-xl p-3">
            <div class="text-[10px] text-gray-500 uppercase tracking-wide mb-1">Win Rate</div>
            <div class="text-sm font-bold font-mono text-emerald-400"><span id="perf-winrate-mirror"><%= (typeof performanceData !== 'undefined' && performanceData && performanceData.winRate != null) ? performanceData.winRate.toFixed(1) + '%' : '--' %></span></div>
          </div>
          <div class="glass-tight rounded-xl p-3">
            <div class="text-[10px] text-gray-500 uppercase tracking-wide mb-1">Current Price</div>
            <div class="text-sm font-bold font-mono text-white" id="market-price">--</div>
          </div>
          <div class="glass-tight rounded-xl p-3">
            <div class="text-[10px] text-gray-500 uppercase tracking-wide mb-1">Next Candle</div>
            <div class="text-sm font-bold font-mono text-gray-200" id="stat-next-candle">--</div>
          </div>
          <div class="glass-tight rounded-xl p-3">
            <div class="text-[10px] text-gray-500 uppercase tracking-wide mb-1">Market</div>
            <div class="text-sm font-bold text-gray-200" id="stat-market-condition">--</div>
          </div>
        </div>

        <!-- Current Position Card -->
        <div class="glass rounded-2xl p-4">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wider flex items-center gap-2">
              <i data-lucide="layers" class="w-3.5 h-3.5"></i> Current Position
            </h2>
            <span id="stat-last-signal" class="text-[10px] text-gray-500 font-mono truncate max-w-[110px]">
              <% if (typeof initialSignals !== 'undefined' && initialSignals && initialSignals.length) { %>
                <%= initialSignals[0].type %> (<%= initialSignals[0].decision %>)
              <% } else { %>--<% } %>
            </span>
          </div>
          <!-- NOVA TRADE -- PART 9: sourced exclusively from an
               authoritative, OPEN Position document for this instance
               (controllers/botController.js), never from the legacy
               BotEngineManager runtime. Only fields that actually exist on
               the Position schema are rendered; there is no invented
               fallback. -->
          <div id="position-card-content" class="space-y-3 text-sm">
            <% if (typeof currentPosition !== 'undefined' && currentPosition) { %>
              <div class="flex justify-between items-center">
                <span class="text-gray-400">Side</span>
                <span class="font-bold <%= currentPosition.side === 'LONG' ? 'text-emerald-400' : 'text-rose-400' %>"><%= currentPosition.side %> <%= currentPosition.leverage %>x</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-400">Symbol</span>
                <span class="font-mono"><%= currentPosition.symbol %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-400">Quantity</span>
                <span class="font-mono"><%= currentPosition.quantity %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-400">Entry Price</span>
                <span class="font-mono">$<%= currentPosition.entryPrice %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-400">Current Price</span>
                <span id="pos-current-price" class="font-mono">$<%= currentPosition.currentPrice %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-400">Unrealized PnL</span>
                <span id="pos-pnl" class="font-mono font-bold <%= currentPosition.unrealizedPnl >= 0 ? 'text-emerald-400' : 'text-rose-400' %>">
                  $<%= currentPosition.unrealizedPnl.toFixed(2) %><%= currentPosition.pnlPct != null ? ` (${currentPosition.pnlPct.toFixed(2)}%)` : '' %>
                </span>
              </div>
              <div class="grid grid-cols-2 gap-2 text-xs pt-2 border-t border-white/5">
                <div><span class="text-gray-500">TP:</span> <span class="font-mono text-emerald-400"><%= currentPosition.takeProfit != null ? `$${currentPosition.takeProfit}` : 'N/A' %></span></div>
                <div><span class="text-gray-500">SL:</span> <span class="font-mono text-rose-400"><%= currentPosition.stopLoss != null ? `$${currentPosition.stopLoss}` : 'N/A' %></span></div>
              </div>
              <div class="text-[10px] text-gray-500 pt-1">Opened <%= currentPosition.openedAt ? new Date(currentPosition.openedAt).toLocaleString() : 'N/A' %></div>
            <% } else { %>
              <div id="position-card-empty" class="text-center py-6 text-gray-500 italic flex flex-col items-center gap-2">
                <i data-lucide="circle-slash" class="w-5 h-5"></i>
                No Active Open Position
              </div>
            <% } %>
          </div>
        </div>

      </section>
    </div>

    <!-- ================= SECTION 2: CONTROL CENTER ================= -->
    <section id="control-center" class="glass rounded-2xl p-4">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wider flex items-center gap-2">
          <i data-lucide="sliders-horizontal" class="w-3.5 h-3.5"></i> Control Center
        </h2>
        <span id="ctl-toast" class="text-[11px] text-gray-500 opacity-0"></span>
      </div>

      <div class="flex flex-col xl:flex-row gap-4">
        <!-- Run controls -->
        <div class="flex flex-wrap items-center gap-2">
          <button id="ctl-start-btn" data-action="start" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/25 hover:bg-emerald-500/20 transition disabled:opacity-50 disabled:pointer-events-none">
            <i data-lucide="play" class="w-3.5 h-3.5"></i> Start
          </button>
          <button id="ctl-pause-btn" data-action="pause" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/25 hover:bg-amber-500/20 transition disabled:opacity-50 disabled:pointer-events-none">
            <i data-lucide="pause" class="w-3.5 h-3.5"></i> Pause
          </button>
          <button id="ctl-stop-btn" data-action="stop" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold bg-rose-500/10 text-rose-400 border border-rose-500/25 hover:bg-rose-500/20 transition disabled:opacity-50 disabled:pointer-events-none">
            <i data-lucide="square" class="w-3.5 h-3.5"></i> Stop
          </button>
          <div class="w-px h-8 bg-white/10 mx-1 hidden sm:block"></div>
          <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold bg-white/5 border border-white/10 text-gray-300 uppercase">
            <i data-lucide="shield" class="w-3.5 h-3.5"></i> <%= bot.environment || bot.tradingMode || 'PAPER' %>
          </span>
        </div>

        <div class="w-px bg-white/10 hidden xl:block"></div>

        <!-- Editable parameters -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 flex-1">
          <div>
            <label class="text-[10px] text-gray-500 uppercase tracking-wide">Capital</label>
            <input id="ctl-capital" type="text" value="<%= Number(bot.capitalAllocation || bot.capital || 0).toLocaleString() %>" class="w-full mt-1 bg-black/30 border border-white/10 rounded-lg px-2.5 py-1.5 text-xs font-mono text-gray-200 focus:outline-none focus:border-blue-500/50">
          </div>
          <div>
            <label class="text-[10px] text-gray-500 uppercase tracking-wide">Risk %</label>
            <input id="ctl-risk" type="text" value="<%= (bot.parameters && bot.parameters.riskPct != null) ? bot.parameters.riskPct : '' %>" class="w-full mt-1 bg-black/30 border border-white/10 rounded-lg px-2.5 py-1.5 text-xs font-mono text-gray-200 focus:outline-none focus:border-blue-500/50">
          </div>
          <div>
            <label class="text-[10px] text-gray-500 uppercase tracking-wide">Leverage</label>
            <input id="ctl-leverage" type="text" value="<%= (typeof currentPosition !== 'undefined' && currentPosition) ? currentPosition.leverage : (bot.leverage || '') %>" class="w-full mt-1 bg-black/30 border border-white/10 rounded-lg px-2.5 py-1.5 text-xs font-mono text-gray-200 focus:outline-none focus:border-blue-500/50">
          </div>
          <div>
            <label class="text-[10px] text-gray-500 uppercase tracking-wide">Strategy</label>
            <input id="ctl-strategy" type="text" value="<%= bot.modelId === 'MODEL_002' ? 'MODEL_002 — Custom Pattern' : (bot.modelId || '') %>" class="w-full mt-1 bg-black/30 border border-white/10 rounded-lg px-2.5 py-1.5 text-xs font-mono text-gray-200 focus:outline-none focus:border-blue-500/50" readonly>
          </div>
          <div>
            <label class="text-[10px] text-gray-500 uppercase tracking-wide">Symbol</label>
            <input id="ctl-symbol" type="text" value="<%= bot.symbol || bot.tradingPair || '' %>" class="w-full mt-1 bg-black/30 border border-white/10 rounded-lg px-2.5 py-1.5 text-xs font-mono text-gray-200 focus:outline-none focus:border-blue-500/50" readonly>
          </div>
          <div>
            <label class="text-[10px] text-gray-500 uppercase tracking-wide">Timeframe</label>
            <input id="ctl-timeframe" type="text" placeholder="--" value="<%= (bot.parameters && bot.parameters.timeframe) || '' %>" <%= bot.status === 'RUNNING' ? 'readonly title="Pause or stop the bot to change timeframe"' : '' %> class="w-full mt-1 bg-black/30 border border-white/10 rounded-lg px-2.5 py-1.5 text-xs font-mono text-gray-200 focus:outline-none focus:border-blue-500/50 <%= bot.status === 'RUNNING' ? 'opacity-60 cursor-not-allowed' : '' %>">
          </div>
        </div>
      </div>

      <% if (bot.modelId === 'MODEL_002') { %>
      <!-- MODEL_002 SAFETY — layer-based safety is the single source of truth. -->
      <% var safetyPayload = (typeof initialDecision !== 'undefined' && initialDecision) ? initialDecision.payload : {}; %>
      <%
        var layerSafety = (safetyPayload && safetyPayload.layerSafety) ? safetyPayload.layerSafety : null;
        var layerStatus = (layerSafety && layerSafety.safetyStatus) ? layerSafety.safetyStatus : 'NORMAL';
        var layerStopped = layerStatus === 'SUCCESS_STOPPED';
        var badgeText = layerStopped ? layerStatus : 'ACTIVE';
        var badgeClass = layerStopped
          ? 'bg-rose-950 text-rose-400 border border-rose-800'
          : 'bg-emerald-950 text-emerald-400 border border-emerald-800';
      %>
      <div class="mt-4 pt-4 border-t border-white/5 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-[10px] text-gray-500 uppercase tracking-wide">Safety</span>
          <span id="safety-status-badge" class="text-[11px] font-semibold px-2 py-0.5 rounded-full <%= badgeClass %>">
            <%= badgeText %>
          </span>
        </div>
      </div>
      <div class="mt-2 grid grid-cols-2 sm:grid-cols-3 gap-2 text-[11px] font-mono text-gray-400">
        <% const ll = (layerSafety && layerSafety.levelLosses) || {}; %>
        <% ['S1','S2','S3','R1','R2','R3'].forEach(function(level) { %>
          <span><%= level %> <span id="layer-safety-<%= level %>" class="text-gray-200 font-bold"><%= ll[level] != null ? ll[level] : 0 %></span>/2</span>
        <% }); %>
      </div>
      <div class="mt-2 text-[11px] font-mono text-gray-400">
        Successful trades <span id="layer-safety-wins" class="text-gray-200 font-bold"><%= layerSafety && layerSafety.successfulTradeCount != null ? layerSafety.successfulTradeCount : 0 %></span>/1
      </div>
      <% if (layerStopped) { %>
      <div id="layer-safety-stop-banner" class="mt-2 text-[11px] text-rose-400">
        <%= 'BOT STOPPED — one successful trade has been completed. No further trades will be taken.' %>
      </div>
      <% } %>
      <% } %>
      <div class="flex flex-wrap items-center justify-between gap-2 mt-4 pt-4 border-t border-white/5">
        <button onclick="toggleAdvancedSettings()" class="inline-flex items-center gap-1.5 text-xs text-gray-400 hover:text-white transition">
          <i data-lucide="chevron-down" id="adv-chevron" class="w-3.5 h-3.5 transition-transform"></i> Advanced Settings
        </button>
        <div class="flex items-center gap-2">
          <button id="ctl-restart-btn" data-action="restart" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-white/5 border border-white/10 text-gray-300 hover:bg-white/10 transition disabled:opacity-50 disabled:pointer-events-none">
            <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i> Restart Bot
          </button>
          <button id="ctl-save-btn" data-action="save" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-blue-500/10 border border-blue-500/25 text-blue-400 hover:bg-blue-500/20 transition disabled:opacity-50 disabled:pointer-events-none">
            <i data-lucide="save" class="w-3.5 h-3.5"></i> Save Configuration
          </button>
        </div>
      </div>

      <div id="adv-settings" data-open="false">
        <% var ctlRunningLocked = bot.status === 'RUNNING'; %>
        <% if (bot.modelId !== 'MODEL_002') { %>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4">
          <div>
            <label class="text-[10px] text-gray-500 uppercase tracking-wide">EMA Length</label>
            <input id="ctl-ema-length" type="text" value="<%= (bot.parameters && bot.parameters.emaLength != null) ? bot.parameters.emaLength : '' %>" class="w-full mt-1 bg-black/30 border border-white/10 rounded-lg px-2.5 py-1.5 text-xs font-mono text-gray-200 focus:outline-none focus:border-blue-500/50">
          </div>
          <div>
            <label class="text-[10px] text-gray-500 uppercase tracking-wide">Breakout Lookback</label>
            <input id="ctl-breakout-lookback" type="text" value="<%= (bot.parameters && bot.parameters.breakoutLookback != null) ? bot.parameters.breakoutLookback : '' %>" class="w-full mt-1 bg-black/30 border border-white/10 rounded-lg px-2.5 py-1.5 text-xs font-mono text-gray-200 focus:outline-none focus:border-blue-500/50">
          </div>
          <div>
            <label class="text-[10px] text-gray-500 uppercase tracking-wide">Body Ratio</label>
            <input id="ctl-body-ratio" type="text" value="<%= (bot.parameters && bot.parameters.minBodyRatio != null) ? bot.parameters.minBodyRatio : '' %>" class="w-full mt-1 bg-black/30 border border-white/10 rounded-lg px-2.5 py-1.5 text-xs font-mono text-gray-200 focus:outline-none focus:border-blue-500/50">
          </div>
        </div>

        <!-- PART 13 -- PHASE D/P/Q: canonical Top/Bottom Level, Target
             Levels, and Sizing Mode. Strategy-sensitive, so locked to
             read-only while the bot is RUNNING (matches Timeframe above) —
             pause or stop to edit, matching BotManager.updateConfiguration.
             MODEL_001 only — MODEL_002 uses user-supplied trend/support/
             resistance instead (see the MODEL_002 block below). -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-3">
          <div>
            <label class="text-[10px] text-gray-500 uppercase tracking-wide">Top Level</label>
            <input id="ctl-top-level" type="text" value="<%= (bot.levels && bot.levels.top != null) ? bot.levels.top : ((bot.parameters && bot.parameters.topLevel != null) ? bot.parameters.topLevel : '') %>" <%= ctlRunningLocked ? 'readonly title="Pause or stop the bot to change levels"' : '' %> class="w-full mt-1 bg-black/30 border border-white/10 rounded-lg px-2.5 py-1.5 text-xs font-mono text-gray-200 focus:outline-none focus:border-blue-500/50 <%= ctlRunningLocked ? 'opacity-60 cursor-not-allowed' : '' %>">
          </div>
          <div>
            <label class="text-[10px] text-gray-500 uppercase tracking-wide">Bottom Level</label>
            <input id="ctl-bottom-level" type="text" value="<%= (bot.levels && bot.levels.bottom != null) ? bot.levels.bottom : ((bot.parameters && bot.parameters.bottomLevel != null) ? bot.parameters.bottomLevel : '') %>" <%= ctlRunningLocked ? 'readonly title="Pause or stop the bot to change levels"' : '' %> class="w-full mt-1 bg-black/30 border border-white/10 rounded-lg px-2.5 py-1.5 text-xs font-mono text-gray-200 focus:outline-none focus:border-blue-500/50 <%= ctlRunningLocked ? 'opacity-60 cursor-not-allowed' : '' %>">
          </div>
          <div>
            <label class="text-[10px] text-gray-500 uppercase tracking-wide">Target Levels</label>
            <input id="ctl-targets" type="text" placeholder="e.g. 65000, 66000" value="<%= (bot.targets || []).map(function(t){ return t.price; }).join(', ') %>" <%= ctlRunningLocked ? 'readonly title="Pause or stop the bot to change targets"' : '' %> class="w-full mt-1 bg-black/30 border border-white/10 rounded-lg px-2.5 py-1.5 text-xs font-mono text-gray-200 focus:outline-none focus:border-blue-500/50 <%= ctlRunningLocked ? 'opacity-60 cursor-not-allowed' : '' %>">
          </div>
          <div>
            <label class="text-[10px] text-gray-500 uppercase tracking-wide">Sizing Mode</label>
            <select id="ctl-sizing-mode" <%= ctlRunningLocked ? 'disabled title="Pause or stop the bot to change sizing mode"' : '' %> class="w-full mt-1 bg-black/30 border border-white/10 rounded-lg px-2.5 py-1.5 text-xs font-mono text-gray-200 focus:outline-none focus:border-blue-500/50 <%= ctlRunningLocked ? 'opacity-60 cursor-not-allowed' : '' %>">
              <option value="CAPITAL" <%= (!bot.sizing || bot.sizing.mode === 'CAPITAL') ? 'selected' : '' %>>Capital-based</option>
              <option value="LOT" <%= (bot.sizing && bot.sizing.mode === 'LOT') ? 'selected' : '' %>>Lot / Contract</option>
            </select>
          </div>
          <div id="ctl-lot-value-field" style="<%= (bot.sizing && bot.sizing.mode === 'LOT') ? '' : 'display:none;' %>">
            <label class="text-[10px] text-gray-500 uppercase tracking-wide">Lot / Contract Quantity</label>
            <input id="ctl-lot-value" type="text" value="<%= (bot.sizing && bot.sizing.value != null) ? bot.sizing.value : '' %>" <%= ctlRunningLocked ? 'readonly' : '' %> class="w-full mt-1 bg-black/30 border border-white/10 rounded-lg px-2.5 py-1.5 text-xs font-mono text-gray-200 focus:outline-none focus:border-blue-500/50 <%= ctlRunningLocked ? 'opacity-60 cursor-not-allowed' : '' %>">
          </div>
        </div>
        <% } else { %>
        <!-- MODEL_002 — Custom Pattern: trend/support/resistance are
             user-supplied. Editable here (same Pause/Stop -> edit -> Save
             -> Restart workflow as every other field on this page), using
             the existing Save Configuration mechanism and the existing
             MODEL_002 validation rules (exactly 3 numeric positive levels
             each) — see collectConfigPayload() below and
             BotManager.updateConfiguration server-side. -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4">
          <div>
            <label class="text-[10px] text-gray-500 uppercase tracking-wide">Trend</label>
            <select id="ctl-m002-trend" <%= ctlRunningLocked ? 'disabled title="Pause or stop the bot to change trend"' : '' %> class="w-full mt-1 bg-black/30 border border-white/10 rounded-lg px-2.5 py-1.5 text-xs font-mono <%= (bot.parameters && bot.parameters.trend === 'BULLISH') ? 'text-emerald-400' : (bot.parameters && bot.parameters.trend === 'BEARISH') ? 'text-rose-400' : 'text-gray-200' %> focus:outline-none focus:border-blue-500/50 <%= ctlRunningLocked ? 'opacity-60 cursor-not-allowed' : '' %>">
              <option value="BULLISH" <%= (bot.parameters && bot.parameters.trend === 'BULLISH') ? 'selected' : '' %>>BULLISH</option>
              <option value="BEARISH" <%= (bot.parameters && bot.parameters.trend === 'BEARISH') ? 'selected' : '' %>>BEARISH</option>
            </select>
          </div>
          <div>
            <label class="text-[10px] text-gray-500 uppercase tracking-wide">Maximum Capital</label>
            <div class="w-full mt-1 bg-black/30 border border-white/10 rounded-lg px-2.5 py-1.5 text-xs font-mono text-gray-200">
              $<%= (bot.capitalAllocation != null) ? bot.capitalAllocation : '—' %>
            </div>
          </div>
          <div>
            <label class="text-[10px] text-gray-500 uppercase tracking-wide">Support Levels (S1 / S2 / S3)</label>
            <div class="grid grid-cols-3 gap-1 mt-1">
              <% var s = (bot.parameters && Array.isArray(bot.parameters.support)) ? bot.parameters.support : []; %>
              <% for (var si = 0; si < 3; si++) { %>
              <input id="ctl-m002-support-<%= si %>" type="text" inputmode="decimal" placeholder="S<%= si + 1 %>" value="<%= (s[si] != null) ? s[si] : '' %>" <%= ctlRunningLocked ? 'readonly title="Pause or stop the bot to change support"' : '' %> class="w-full bg-black/30 border border-white/10 rounded-lg px-2 py-1.5 text-xs font-mono text-gray-200 focus:outline-none focus:border-blue-500/50 <%= ctlRunningLocked ? 'opacity-60 cursor-not-allowed' : '' %>">
              <% } %>
            </div>
          </div>
          <div>
            <label class="text-[10px] text-gray-500 uppercase tracking-wide">Resistance Levels (R1 / R2 / R3)</label>
            <div class="grid grid-cols-3 gap-1 mt-1">
              <% var r = (bot.parameters && Array.isArray(bot.parameters.resistance)) ? bot.parameters.resistance : []; %>
              <% for (var ri = 0; ri < 3; ri++) { %>
              <input id="ctl-m002-resistance-<%= ri %>" type="text" inputmode="decimal" placeholder="R<%= ri + 1 %>" value="<%= (r[ri] != null) ? r[ri] : '' %>" <%= ctlRunningLocked ? 'readonly title="Pause or stop the bot to change resistance"' : '' %> class="w-full bg-black/30 border border-white/10 rounded-lg px-2 py-1.5 text-xs font-mono text-gray-200 focus:outline-none focus:border-blue-500/50 <%= ctlRunningLocked ? 'opacity-60 cursor-not-allowed' : '' %>">
              <% } %>
            </div>
          </div>
        </div>
        <% } %>
      </div>
    </section>

    <!-- ================= TARGET EXIT ================= -->
    <section id="target-exit-section" class="glass rounded-2xl p-4 mt-4">
      <div class="flex items-center justify-between gap-3 mb-4">
        <div>
          <h2 class="text-xs font-semibold text-gray-300 uppercase tracking-wider flex items-center gap-2"><i data-lucide="target" class="w-3.5 h-3.5"></i> Target Exit</h2>
          <p class="text-[10px] text-gray-500 mt-1">Configure after a position is open. T1–T3 share one 3-candle window. T4 exits all remaining quantity immediately.</p>
        </div>
        <span id="target-exit-status" class="text-[10px] font-mono px-2 py-1 rounded-full bg-white/5 border border-white/10 text-gray-500">No active plan</span>
      </div>
      <div id="target-no-position" class="text-xs text-gray-500 py-5 text-center border border-dashed border-white/10 rounded-xl <%= (typeof currentPosition !== 'undefined' && currentPosition) ? 'hidden' : '' %>">
        Open a position first to configure Target Exit.
      </div>
      <div id="target-form-wrap" class="<%= (typeof currentPosition !== 'undefined' && currentPosition) ? '' : 'hidden' %>">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          <% for (var ti=1; ti<=4; ti++) { %>
          <div class="rounded-xl border border-white/10 bg-white/[0.025] p-3">
            <div class="flex items-center justify-between mb-2"><span class="text-xs font-bold text-gray-200">T<%= ti %></span><span id="target-state-<%= ti %>" class="text-[9px] uppercase text-gray-500">Waiting</span></div>
            <label class="text-[10px] text-gray-500 uppercase tracking-wide">Target Price</label>
            <input id="target-price-<%= ti %>" inputmode="decimal" type="text" class="w-full mt-1 bg-black/30 border border-white/10 rounded-lg px-2.5 py-2 text-xs font-mono text-gray-200 focus:outline-none focus:border-blue-500/50" placeholder="Price">
            <% if (ti < 4) { %>
              <label class="text-[10px] text-gray-500 uppercase tracking-wide block mt-2">Exit %</label>
              <input id="target-percent-<%= ti %>" inputmode="decimal" type="text" class="w-full mt-1 bg-black/30 border border-white/10 rounded-lg px-2.5 py-2 text-xs font-mono text-gray-200 focus:outline-none focus:border-blue-500/50" placeholder="30">
            <% } else { %>
              <div class="mt-2 flex items-center justify-between"><span class="text-[10px] text-gray-500 uppercase">Exit</span><span id="target-t4-remaining" class="font-mono text-emerald-400 text-sm font-bold">10%</span></div>
              <div class="text-[9px] text-gray-600 mt-1">Remaining quantity</div>
            <% } %>
          </div>
          <% } %>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3 mt-4 pt-3 border-t border-white/5">
          <div class="text-[10px] text-gray-500">T1 + T2 + T3 must equal <b class="text-gray-300">90%</b>. T4 is the remaining <b class="text-gray-300">10%</b>. No timeframe switching.</div>
          <button id="target-activate-btn" type="button" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold bg-blue-500/10 border border-blue-500/25 text-blue-400 hover:bg-blue-500/20 transition">Activate Target Exit</button>
        </div>
        <div id="target-error" class="hidden mt-3 text-[11px] text-rose-400"></div>
      </div>
    </section>

    <!-- ================= SECTION 3: DETAILED TABS ================= -->
    <section class="glass rounded-2xl overflow-hidden">
      <div class="flex items-center gap-1 px-2 sm:px-4 border-b border-white/5 overflow-x-auto scrollbar-thin">
        <button class="tab-btn" data-tab="performance" data-active="true" onclick="switchTab('performance')">
          <span class="flex items-center gap-1.5 px-3 sm:px-4 py-3 text-xs font-semibold text-gray-400 whitespace-nowrap"><i data-lucide="trending-up" class="w-3.5 h-3.5"></i> Performance</span>
        </button>
        <button class="tab-btn" data-tab="trades" data-active="false" onclick="switchTab('trades')">
          <span class="flex items-center gap-1.5 px-3 sm:px-4 py-3 text-xs font-semibold text-gray-400 whitespace-nowrap"><i data-lucide="list-ordered" class="w-3.5 h-3.5"></i> Trade History</span>
        </button>
        <button class="tab-btn" data-tab="decisions" data-active="false" onclick="switchTab('decisions')">
          <span class="flex items-center gap-1.5 px-3 sm:px-4 py-3 text-xs font-semibold text-gray-400 whitespace-nowrap"><i data-lucide="git-branch" class="w-3.5 h-3.5"></i> Decision History</span>
        </button>
        <button class="tab-btn" data-tab="recordings" data-active="false" onclick="switchTab('recordings')">
          <span class="flex items-center gap-1.5 px-3 sm:px-4 py-3 text-xs font-semibold text-gray-400 whitespace-nowrap"><i data-lucide="video" class="w-3.5 h-3.5"></i> Break Recordings</span>
        </button>
        <button class="tab-btn" data-tab="indicators" data-active="false" onclick="switchTab('indicators')">
          <span class="flex items-center gap-1.5 px-3 sm:px-4 py-3 text-xs font-semibold text-gray-400 whitespace-nowrap"><i data-lucide="activity" class="w-3.5 h-3.5"></i> Indicators</span>
        </button>
        <button class="tab-btn" data-tab="logs" data-active="false" onclick="switchTab('logs')">
          <span class="flex items-center gap-1.5 px-3 sm:px-4 py-3 text-xs font-semibold text-gray-400 whitespace-nowrap"><i data-lucide="terminal" class="w-3.5 h-3.5"></i> Logs</span>
        </button>
        <button class="tab-btn" data-tab="system" data-active="false" onclick="switchTab('system')">
          <span class="flex items-center gap-1.5 px-3 sm:px-4 py-3 text-xs font-semibold text-gray-400 whitespace-nowrap"><i data-lucide="cpu" class="w-3.5 h-3.5"></i> System</span>
        </button>
      </div>

      <div class="p-4">

        <!-- PERFORMANCE TAB -->
        <!-- NOVA TRADE -- PART 9: every metric below is computed server-side
             in controllers/botController.js from real, closed Trade
             documents (utils/performance.js) -- never from initialTrades'
             length/filter (which was both wrong, using a non-existent
             `pnl` field, and incomplete, since initialTrades is capped at
             50 for the Trade History tab). Zero-trade states render "--",
             never an invalid numeric string.
             PART 14 -- PHASE H: Max Drawdown is now computed from the same
             real closed-Trade history (utils/performance.js,
             computeMaxDrawdown) -- no longer a hardcoded "N/A". Equity
             Curve stays unimplemented (no persisted equity-curve series
             yet, and rendering one is a chart-visualization feature, not a
             computable stat -- out of scope for this part). -->
        <div class="tab-panel" data-tab="performance" data-active="true">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
            <div class="glass-tight rounded-xl p-3 text-center">
              <div class="text-[10px] text-gray-500 uppercase">Total Profit</div>
              <div id="perf-total-pnl" class="text-lg font-bold font-mono <%= (typeof performanceData !== 'undefined' && performanceData && performanceData.totalProfit >= 0) ? 'text-emerald-400' : 'text-rose-400' %> mt-1">$<%= typeof performanceData !== 'undefined' && performanceData ? performanceData.totalProfit.toFixed(2) : '0.00' %></div>
            </div>
            <div class="glass-tight rounded-xl p-3 text-center">
              <div class="text-[10px] text-gray-500 uppercase">Win Rate</div>
              <div id="perf-winrate" class="text-lg font-bold font-mono text-emerald-400 mt-1"><%= (typeof performanceData !== 'undefined' && performanceData && performanceData.winRate != null) ? performanceData.winRate.toFixed(1) + '%' : '--' %></div>
            </div>
            <div class="glass-tight rounded-xl p-3 text-center">
              <div class="text-[10px] text-gray-500 uppercase">Profit Factor</div>
              <div id="perf-profit-factor" class="text-lg font-bold font-mono text-gray-200 mt-1"><%
                var pf = typeof performanceData !== 'undefined' && performanceData ? performanceData.profitFactor : null;
                if (pf == null) { %>--<% } else if (pf === Infinity) { %>&#8734;<% } else { %><%= pf.toFixed(2) %><% } %></div>
            </div>
            <div class="glass-tight rounded-xl p-3 text-center">
              <div class="text-[10px] text-gray-500 uppercase">Max Drawdown</div>
              <div id="perf-drawdown" class="text-lg font-bold font-mono text-rose-400 mt-1"><%= (typeof performanceData !== 'undefined' && performanceData && Number.isFinite(performanceData.maxDrawdown)) ? ('$' + performanceData.maxDrawdown.toFixed(2)) : 'N/A' %></div>
            </div>
          </div>
          <div class="grid grid-cols-3 gap-3 mb-4">
            <div class="glass-tight rounded-xl p-3 text-center">
              <div class="text-[10px] text-gray-500 uppercase">Total Trades</div>
              <div id="perf-total-trades" class="text-sm font-bold font-mono text-gray-200 mt-1"><%= typeof performanceData !== 'undefined' && performanceData ? performanceData.totalTrades : '--' %></div>
            </div>
            <div class="glass-tight rounded-xl p-3 text-center">
              <div class="text-[10px] text-gray-500 uppercase">Winning Trades</div>
              <div id="perf-winning-trades" class="text-sm font-bold font-mono text-emerald-400 mt-1"><%= typeof performanceData !== 'undefined' && performanceData ? performanceData.winningTrades : '--' %></div>
            </div>
            <div class="glass-tight rounded-xl p-3 text-center">
              <div class="text-[10px] text-gray-500 uppercase">Losing Trades</div>
              <div id="perf-losing-trades" class="text-sm font-bold font-mono text-rose-400 mt-1"><%= typeof performanceData !== 'undefined' && performanceData ? performanceData.losingTrades : '--' %></div>
            </div>
          </div>
